{
  "homepage": "https://github.com/ASDAlexander77/TypeScriptLUA/#readme",
  "keywords": [
    "typescript",
    "lua",
    "tsc-lua",
    "compiler"
  ],
  "license": "MIT",
  "main": "__out/src/main.js",
  "name": "typescript_lua",
  "version": "1.0.0",
  "description": "",
  "scripts": {
    "run": "node __out/src/main.js",
    "test": "mocha -u tdd --timeout 10000 --colors -r ts-node/register spec/**/*.spec.ts",
    "watch": "tsc -w -p ./",
    "lint": "tslint src/**/*.ts -t verbose",
    "build": "tsc",
    "build-jslib-dts": "ts-node scripts/build-jslib-dts.ts",
    "conformance": "ts-node scripts/conformance-survey.ts",
    "conformance:refresh": "ts-node scripts/refresh-conformance.ts",
    "conformance:selftest": "mocha -u tdd --timeout 180000 --colors -r ts-node/register selftest/**/*.spec.ts",
    "exec": "ts-node src/main.ts",
    "prepublish": "prepublish_npm.cmd"
  },
  "bin": {
    "tsc-lua": "./__out/src/main.js"
  },
  "bugs": {
    "url": "https://github.com/ASDAlexander77/TypeScriptLUA/issues"
  },
  "private": true,
  "dependencies": {
    "cross-spawn": "^6.0.5",
    "fs-extra": "^7.0.1",
    "npm": "^6.12.0",
    "path": "^0.12.7",
    "source-map": "^0.7.3",
    "typescript": "^3.3.0"
  },
  "devDependencies": {
    "@types/chai": "^4.1.7",
    "@types/fs-extra": "^5.0.5",
    "@types/mocha": "^5.2.6",
    "@types/node": "~13.13.52",
    "chai": "^4.2.0",
    "mocha": "^5.2.0",
    "ts-node": "^7.0.1",
    "tslint": "^5.12.1",
    "typescript": "^3.3.0-dev"
  }
}
