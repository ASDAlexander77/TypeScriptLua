{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "lua",
            "request": "launch",
            "name": "Debug Babyloncli (Without PreLaunchTask)",
            "cwd": "${workspaceFolder}",
            //"program": "${workspaceFolder}/${command:AskForProgramName}",
            "program": "${workspaceFolder}/babyloncli.lua",
            "cpath": "I:/TypeScriptLua/__dist/?.dll",
            "runtimeExecutable": "I:/TypeScriptLua/__dist/lua.exe",
            "runtimeArgs": [
                "-e",
                "package.path = package.path .. ';I:/TypeScriptLua/__dist/?.lua'",
                "${workspaceFolder}/babyloncli.lua",
                "-i",
                "1"
            ],
            "stopOnEntry": true
        },
        {
            "type": "lua",
            "request": "launch",
